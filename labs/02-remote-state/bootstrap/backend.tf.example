# Copy to backend.tf to move the state of this configuration into the bucket
# it created. kms_key_id is supplied at init time with -backend-config.
terraform {
  backend "s3" {
    bucket       = "lab02-tfstate"
    key          = "bootstrap/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true

    # Lab-only settings, same purpose as in the provider block.
    access_key                  = "test"
    secret_key                  = "test"
    use_path_style              = true
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_requesting_account_id  = true

    endpoints = {
      s3 = "http://localhost:4566"
    }
  }
}
